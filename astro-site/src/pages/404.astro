---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { publishers } from '~/data'
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." noindex={true}>
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-mono text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-accent)] mb-4">
      404
    </p>
    <h1 class="font-display text-5xl font-bold tracking-tight mb-4">
      <span class="gradient-text">Page not found</span>
    </h1>
    <p class="text-[var(--color-text-2)] mb-8">
      The page you're looking for doesn't exist. It may have been moved or deleted.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="inline-flex items-center gap-2 rounded-md bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] px-5 py-2.5 text-sm font-medium text-white transition-colors">
        Go home
      </a>
      <a href="/publishers" class="inline-flex items-center gap-2 rounded-md border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] px-5 py-2.5 text-sm font-medium transition-colors">
        Browse {publishers.length} publishers
      </a>
    </div>
  </section>
</BaseLayout>
