---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const items = (await getCollection('specs'))
    .filter(i => !i.id.endsWith('.adoc') && i.id !== 'index')
  return items.map(item => ({
    params: { slug: item.id },
    props: { item },
  }))
}

interface Props { item: any }
const { item } = Astro.props
const { Content } = await render(item)
const title = item.data.title || 'Specification'
---

<BaseLayout title={title} description={item.data.description || ''}>
  <article class="mx-auto max-w-4xl px-6 py-16 prose prose-pubid">
    <Content />
  </article>
</BaseLayout>
