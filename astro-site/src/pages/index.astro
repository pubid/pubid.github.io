---
import BaseLayout from '~/layouts/BaseLayout.astro'
import HeroDemo from '~/components/home/HeroDemo.vue'
import ArchitectureDiagram from '~/components/home/ArchitectureDiagram.vue'
import { publishers } from '~/data'

const totalTypes = publishers.reduce((sum, p) => sum + p.docTypes.length, 0)
const previewPublishers = publishers.slice(0, 12)
---

<BaseLayout title="PubID" description="Universal Publication Identifier — Parse, render, and exchange identifiers for 26+ standards publishers.">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0" style="background:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(41, 120, 161, 0.08), transparent),
        radial-gradient(ellipse 50% 50% at 80% 80%, rgba(218, 157, 118, 0.04), transparent);"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-6 pt-32 pb-12 text-center">
      <div class="animate-in">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-accent)] mb-6">
          Open Standard · v2
        </p>
      </div>
      <h1 class="animate-in font-display text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] mb-6" style="animation-delay: 100ms;">
        Universal<br />
        <span class="gradient-text">Publication Identifier</span>
      </h1>
      <p class="animate-in mx-auto max-w-2xl text-lg sm:text-xl text-[var(--color-text-2)] leading-relaxed mb-10" style="animation-delay: 200ms;">
        Parse, render, and exchange standards identifiers across
        <strong class="text-[var(--color-text)]">{publishers.length}+ publishers</strong>
        with a shared metaschema. Machine-readable. Round-trippable. URN-mappable.
      </p>
      <div class="animate-in flex flex-wrap items-center justify-center gap-3" style="animation-delay: 300ms;">
        <a href="/publishers" class="inline-flex items-center gap-2 rounded-md bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] px-5 py-2.5 text-sm font-medium text-white transition-colors">
          Browse publishers
          <span aria-hidden="true">→</span>
        </a>
        <a href="/concepts/anatomy" class="inline-flex items-center gap-2 rounded-md border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] px-5 py-2.5 text-sm font-medium transition-colors">
          Read the concepts
        </a>
      </div>
    </div>

    <!-- Interactive demo -->
    <div class="animate-in mx-auto max-w-3xl px-6 pb-20" style="animation-delay: 400ms;">
      <HeroDemo client:visible />
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="animate-in text-center p-6 card-elevated">
        <div class="font-display text-4xl font-bold gradient-text">{publishers.length}</div>
        <div class="mt-2 text-sm text-[var(--color-text-2)]">Publishers</div>
      </div>
      <div class="animate-in text-center p-6 card-elevated" style="animation-delay: 80ms;">
        <div class="font-display text-4xl font-bold gradient-text">{totalTypes}+</div>
        <div class="mt-2 text-sm text-[var(--color-text-2)]">Doc Types</div>
      </div>
      <div class="animate-in text-center p-6 card-elevated" style="animation-delay: 160ms;">
        <div class="font-display text-4xl font-bold gradient-text">4</div>
        <div class="mt-2 text-sm text-[var(--color-text-2)]">Render Styles</div>
      </div>
      <div class="animate-in text-center p-6 card-elevated" style="animation-delay: 240ms;">
        <div class="font-display text-4xl font-bold gradient-text">100%</div>
        <div class="mt-2 text-sm text-[var(--color-text-2)]">Round-Trip</div>
      </div>
    </div>
  </section>

  <!-- Architecture diagram -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="text-center mb-10">
      <h2 class="animate-in font-display text-3xl font-semibold mb-3">Identifiers compose, like Lego</h2>
      <p class="animate-in text-[var(--color-text-2)] max-w-2xl mx-auto" style="animation-delay: 100ms;">
        A PubID is not a flat string — it's a typed tree. Amendments wrap base standards, corrigenda wrap amendments, adoptions stack national bodies on top. Round-trip fidelity means the tree parses back to the same shape, every time.
      </p>
    </div>
    <div class="animate-in" style="animation-delay: 200ms;">
      <ArchitectureDiagram client:visible />
    </div>
  </section>

  <!-- Publisher preview -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="text-center mb-10">
      <h2 class="animate-in font-display text-3xl font-semibold mb-2">One schema, many publishers</h2>
      <p class="animate-in text-[var(--color-text-2)]" style="animation-delay: 100ms;">From ISO to NIST, BSI to IEEE — PubID scales across the standards world.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {previewPublishers.map(p => (
        <a
          href={`/publishers/${p.flavor}`}
          class="group flex flex-col items-center gap-3 p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:bg-[var(--color-accent-soft)] transition-colors"
        >
          <img src={p.logo} alt={`${p.name} logo`} class="h-10 w-auto" />
          <span class="text-xs font-medium text-[var(--color-text-2)] group-hover:text-[var(--color-accent)]">{p.name}</span>
        </a>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/publishers" class="text-sm text-[var(--color-accent)] hover:underline">
        View all {publishers.length} publishers →
      </a>
    </div>
  </section>
</BaseLayout>
