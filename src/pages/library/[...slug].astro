---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const items = await getCollection('library')
  return items
    .filter(item => item.id !== 'index')
    .map(item => ({
      params: { slug: item.id },
      props: { item },
    }))
}

interface Props { item: any }
const { item } = Astro.props
const { Content } = await render(item)
const title = item.data.title || 'Library'
---

<BaseLayout title={title} description={item.data.description || ''}>
  <article class="prose mx-auto max-w-3xl px-6 pt-20 pb-24">
    <p class="eyebrow mb-4">Library</p>
    <Content />
  </article>
</BaseLayout>
