---
// The Playground: the interactive identifier workbench (issue #22).
//
// Reference-shaped sections describe the input/output contract; the
// interactive component (Playground.vue) runs every parse client-side
// through the pubid-wasm bundle. The reference sections render from
// the same site data the docs pages render from — no hand-maintained
// flavor lists.
import BaseLayout from '~/layouts/BaseLayout.astro'
import Playground from '~/components/playground/Playground.vue'
import { publishers } from '~/data'
import wasmBundle from '~/data/wasm-bundle.json'

const docLinkCount = publishers.filter(p => p.urnDocs).length
---

<BaseLayout
  title="Playground — the identifier workbench"
  description="Type any standards identifier: the typed tree, the canonical render, the URN/MRN form and the flavor detection, parsed client-side by the pubid-rs engine compiled to WebAssembly."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-sm text-[var(--color-text-3)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-accent)]">Home</a>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-text)]">Playground</span>
    </nav>

    <header class="mb-10">
      <h1 class="font-display text-4xl font-bold tracking-tight mb-3">The Playground</h1>
      <p class="text-base text-[var(--color-text-2)] leading-relaxed max-w-3xl">
        An identifier workbench over the real engine: type any identifier and the
        Rust implementation — <a href="https://github.com/pubid/pubid-rs" class="text-[var(--color-accent)] hover:underline">pubid-rs</a>
        compiled to WebAssembly — parses it client-side, no server round-trip.
        The grammar artifacts are the checksummed PARG envelopes the whole fleet
        shares, bundled with the engine and re-verified at load.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <span class="px-3 py-1.5 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)]">
          <span class="text-[var(--color-text-3)] uppercase tracking-wide mr-1.5">Engine</span>
          pubid-wasm v{wasmBundle.source.crate_version} · <a
            class="font-mono hover:text-[var(--color-accent)]"
            href={`https://github.com/pubid/pubid-rs/commit/${wasmBundle.source.commit}`}
          >{wasmBundle.source.commit.slice(0, 12)}</a>
        </span>
        <span class="px-3 py-1.5 rounded-md bg-[var(--color-bg-raised)] border border-[var(--color-border)]">
          <span class="text-[var(--color-text-3)] uppercase tracking-wide mr-1.5">Bundle</span>
          {(wasmBundle.files['pubid_wasm_bg.wasm'].bytes / 1024 / 1024).toFixed(2)} MB wasm — the ported fleet rides the engine (the ready line shows the count)
        </span>
      </div>
    </header>

    <!-- The interactive workbench -->
    <section class="mb-12" aria-label="Identifier workbench">
      <Playground client:load />
    </section>

    <!-- Reference-shaped sections: the input/output contract -->
    <section class="mb-12">
      <div class="eyebrow mb-3">Reference</div>
      <h2 class="font-display text-2xl font-bold tracking-tight mb-4">The input/output contract</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="p-4 card-elevated">
          <div class="text-xs uppercase tracking-wide text-[var(--color-text-3)] mb-2">Input</div>
          <p class="text-sm text-[var(--color-text-2)] leading-relaxed">
            Any spelling of a standards identifier. In <em>auto-detect</em> mode
            every ported flavor tries the input and the fastest-ordered hit parses
            it; in manual mode the chosen flavor's grammar decides. A grammar
            rejection, a failed check digit or an unknown flavor all come back as
            a verdict — the workbench never throws.
          </p>
        </div>
        <div class="p-4 card-elevated">
          <div class="text-xs uppercase tracking-wide text-[var(--color-text-3)] mb-2">Output</div>
          <p class="text-sm text-[var(--color-text-2)] leading-relaxed">
            The <strong>typed tree</strong> (the canonical <code class="font-mono">_type</code>-tagged
            attribute hash), the <strong>canonical</strong> human render, and the
            <strong>URN/MRN</strong> emission with its namespace class —
            <code class="font-mono">urn</code> for the RFC 8141 forms, <code class="font-mono">mrn</code>
            for the <code class="font-mono">urn:mrn:</code> member identifiers (IHO, IALA, WMO).
          </p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <div class="eyebrow mb-3">Reference</div>
      <h2 class="font-display text-2xl font-bold tracking-tight mb-4">The verdict classes</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[var(--color-text-3)] border-b border-[var(--color-border)]">
              <th class="py-2 pr-4 font-medium">code</th>
              <th class="py-2 font-medium">meaning</th>
            </tr>
          </thead>
          <tbody class="font-mono">
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">(ok)</td>
              <td class="py-2 text-[var(--color-text-2)] font-sans">the input parsed; <code>result</code> carries the report</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">unknown_flavor</td>
              <td class="py-2 text-[var(--color-text-2)] font-sans">no ported flavor of that name (the manual-mode picker prevents this)</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">parse</td>
              <td class="py-2 text-[var(--color-text-2)] font-sans">the grammar rejected the input</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">invalid</td>
              <td class="py-2 text-[var(--color-text-2)] font-sans">the grammar matched but the flavor semantics rejected it (a failed check digit, an out-of-range stage)</td>
            </tr>
            <tr>
              <td class="py-2 pr-4">artifact</td>
              <td class="py-2 text-[var(--color-text-2)] font-sans">a grammar envelope failed to load or verify — never silently tolerated</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-12">
      <div class="eyebrow mb-3">Reference</div>
      <h2 class="font-display text-2xl font-bold tracking-tight mb-4">The engine surface</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-[var(--color-text-3)] border-b border-[var(--color-border)]">
              <th class="py-2 pr-4 font-medium">export</th>
              <th class="py-2 font-medium">the Rust mirror</th>
            </tr>
          </thead>
          <tbody class="font-mono text-xs sm:text-sm">
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">pubid_flavors()</td>
              <td class="py-2 text-[var(--color-text-2)]">implemented_flavors()</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">pubid_parse(f, s)</td>
              <td class="py-2 text-[var(--color-text-2)]">FlavorImpl::parse + the canonical forms</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">pubid_try_parse(f, s)</td>
              <td class="py-2 text-[var(--color-text-2)]">the verdict form (never throws)</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">pubid_detect(s)</td>
              <td class="py-2 text-[var(--color-text-2)]">every flavor that accepts the input</td>
            </tr>
            <tr class="border-b border-[var(--color-border-subtle)]">
              <td class="py-2 pr-4">pubid_examples()</td>
              <td class="py-2 text-[var(--color-text-2)]">the corpus-fed example rows</td>
            </tr>
            <tr>
              <td class="py-2 pr-4">pubid_artifacts()</td>
              <td class="py-2 text-[var(--color-text-2)]">the envelope receipts (checksum, semantics hash)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-[var(--color-text-2)]">
        The example set is fed from the
        <a href="https://github.com/pubid/pubid-testsuite" class="text-[var(--color-accent)] hover:underline">pubid-testsuite</a>
        corpus: the vendored slices the conformance suite gates, distilled to the
        canonical rows. Every row parses under its flavor — the gate is part of
        the engine's own test suite.
      </p>
    </section>

    <section class="mb-12">
      <div class="eyebrow mb-3">Docs</div>
      <h2 class="font-display text-2xl font-bold tracking-tight mb-4">Per-flavor documentation</h2>
      <p class="text-sm text-[var(--color-text-2)] leading-relaxed mb-4">
        When a parse succeeds the workbench links the flavor's
        <a href="/publishers" class="text-[var(--color-accent)] hover:underline">publisher schema page</a>
        and, where one exists, its URN scheme reference ({docLinkCount} flavors carry one under
        <a href="/specs/" class="text-[var(--color-accent)] hover:underline">Specifications</a>).
      </p>
    </section>
  </div>
</BaseLayout>
