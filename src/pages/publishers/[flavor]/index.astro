---
import BaseLayout from '~/layouts/BaseLayout.astro'
import FlavorPage from '~/components/publishers/FlavorPage.vue'
import { publishers, type Publisher } from '~/data'

export async function getStaticPaths() {
  return publishers.map(p => ({
    params: { flavor: p.flavor },
    props: { publisher: p },
  }))
}

interface Props { publisher: Publisher }
const { publisher } = Astro.props
---

<BaseLayout title={`${publisher.name} — Publisher Schema`} description={publisher.description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <FlavorPage publisher={publisher} client:load />
  </div>
</BaseLayout>
