---
import BaseLayout from '~/layouts/BaseLayout.astro'
import PublisherGrid from '~/components/publishers/PublisherGrid.vue'
import { publishers } from '~/data'
---

<BaseLayout title="Publishers" description={`All ${publishers.length} publisher schemas supported by PubID.`}>
  <div class="page-section">
    <div class="section-inner">
      <div class="section-kicker">Ecosystem</div>
      <h1 class="section-heading">Publishers</h1>
      <p class="section-sub">
        Browse all {publishers.length} supported publisher schemes. Each publisher defines their own PubID schema using the shared metaschema — a typed data model that round-trips through human, URN, and JSON formats without information loss.
      </p>

      <PublisherGrid client:load />
    </div>
  </div>
</BaseLayout>
