  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
    <p class="text-sm text-[var(--color-text-3)]">
      An open source project of <a href="https://www.ribose.com" class="text-[var(--color-accent)] hover:underline">Ribose</a>
    </p>
    <p class="text-sm text-[var(--color-text-3)]">
      Copyright © 2024–{year} Ribose Group Inc.
    </p>
  </div>
</footer>
